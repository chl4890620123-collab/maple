# Local development only. Production runtime settings are owned by the Server repository / mini PC.
APP_PORT=18080
BIND_HOST=127.0.0.1
ADMIN_TOKEN=change-me-before-public-deploy
DEFAULT_FEE_RATE=0.05
CORS_ORIGINS=

# Production uses MariaDB. SQLite remains available only for lightweight local tests/fallback.
DB_ENGINE=mariadb
DB_HOST=maple-db
DB_PORT=3306
DB_NAME=maple_craft
DB_USER=maple_app
DB_PASSWORD=change-me-maple-db-password
DB_ROOT_PASSWORD=change-me-maple-root-password
DB_PATH=/app/data/maple_craft.db
