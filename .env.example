# 외부 접속 포트: 기존 80/443 서비스와 겹치지 않도록 별도 포트 사용
APP_PORT=18080
BIND_HOST=0.0.0.0

# 외부 공개 시 반드시 긴 랜덤 문자열로 변경
ADMIN_TOKEN=change-me-before-public-deploy

# DB는 Docker volume 경로 사용
DB_PATH=/app/data/maple_craft.db

# 기본 경매장 판매 수수료. 화면에서 3%/5% 선택 가능
DEFAULT_FEE_RATE=0.05

# CORS가 필요한 별도 프론트엔드가 생길 때만 사용. 현재는 same-origin.
CORS_ORIGINS=
